{% extends "themes/base_admin.html.twig" %}

{% block title %}Modifier ce thème{% endblock %}

{% block description %}Modifier un artiste, un thème ou une émotion{% endblock %}

{% block keywords %}
 <meta name="keywords" content="modifier, tag">
{% endblock %}

{% block main %}
    <h1 class="text-center my-3 display-5">Modifier ce thème artistique</h1>

    <div class="container mt-5">
        <div class="row">
            <div class="col-md-6 mx-auto">
                {{ form_start(tagForm) }}
                    <div class="mb-3">
                        <label for="tag_form_name">Nom de l’artiste, du thème ou de l’émotion: </label>
                        <div class="text-danger">{{form_errors(tagForm.name)}}</div>
                        {{form_widget(tagForm.name, {'attr': {'class':'form-control', 'autofocus':'autofocus'}})}}
                    </div>
                    <div>
                        <input formnovalidate type="submit" class="btn btn-success shadow" value="Modifier">
                    </div>
                {{ form_end(tagForm) }}
            </div>
        </div>
    </div>

{% endblock %}