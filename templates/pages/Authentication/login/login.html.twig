<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Connexion | Regards d’Art - Blog artistique de Paul Martin</title>

        {# Seo #}
        <meta name="robots" content="index, follow">
        <meta name="description" content="Connectez-vous à votre compte Regards d’Art pour suivre les publications de Paul Martin, découvrir ses ressentis autour de tableaux et échanger autour de l’art.">
        <meta name="keywords" content="connexion blog art, compte utilisateur art, peinture, tableaux, Regards d’Art, Paul Martin">
        <meta name="author" content="Paul Martin">
        <meta name="publisher" content="Regards d’Art">

        {# Webpack Encore #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}

        {# Favicon #}
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="shortcut icon" href="/favicon.ico">
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="manifest" href="/site.webmanifest">

        {# Google Font #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">        
    </head>
    <body class="auth-page auth-login-bg">
        <main>
            <div class="auth-container">
                    <div class="auth-card">
                        <h1 class="text-center my-3">Connexion</h1>

                        <form method="post" class="w-100">
                            {% if error %}
                                <div class="alert alert-danger text-center text-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}

                            {% for message in app.flashes('success') %}
                                <div class="alert alert-success text-center text-success" role="alert">
                                    {{ message }}
                                </div>
                            {% endfor %}

                            <div class="mb-3">
                                <label for="inputEmail">Email</label>
                                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                            </div>
                            <div class="mb-3">
                                <label for="inputPassword">Mot de passe</label>
                                <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                            </div>

                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                            <div class="row mb-3">
                                <div class="col-md-6 my-1">
                                    <label>
                                        <input type="checkbox" name="_remember_me"> Se souvenir de moi
                                    </label>
                                </div>
                                <div class="col-md-6 text-md-end my-1">
                                    <a href="{{path('app_forgot_password_request')}}">Mot de passe oublié ?</a>
                                </div>
                            </div>

                            <button formnovalidate class="btn btn-primary shadow w-100" type="submit">Se connecter</button>
                        </form>

                        <div class="d-flex flex-column justify-content-center align-items-center my-4">
                            <p>Vous n'êtes pas encore inscrit ? <a href="{{path('app_register')}}">Inscrivez-vous</a></p>
                            <p><a href="{{path('app_visitor_welcome')}}">Retour à l'accueil</a></p>
                        </div>
                    </div>
            </div>
        </main>
    </body>
</html>

