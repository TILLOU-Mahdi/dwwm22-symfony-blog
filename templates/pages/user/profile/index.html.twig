{% extends "themes/base_user.html.twig" %}

{% block title %}Mon profil{% endblock %}

{% block description %}Modification du profil utilisateur{% endblock %}

{% block main %}
    <div class="container my-5">

        <h1 class="text-center my-4 display-5">
            Mon profil
        </h1>

        <div class="row justify-content-center">
            <div class="col-md-8">

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success text-center">
                        {{ message }}
                    </div>
                {% endfor %}

                <div class="card shadow">
                    <div class="card-body">

                        <p>
                            <strong>Date d’inscription :</strong>
                            {{ user.createdAt|date('d/m/Y H:i') }}
                        </p>

                        <hr>

                        {{ form_start(profileForm) }}

                            <div class="mb-3">
                                {{ form_label(profileForm.firstName) }}
                                {{ form_widget(profileForm.firstName, {'attr': {'class': 'form-control'}}) }}
                                <div class="text-danger">
                                    {{ form_errors(profileForm.firstName) }}
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(profileForm.lastName) }}
                                {{ form_widget(profileForm.lastName, {'attr': {'class': 'form-control'}}) }}
                                <div class="text-danger">
                                    {{ form_errors(profileForm.lastName) }}
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(profileForm.email) }}
                                {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
                                <div class="text-danger">
                                    {{ form_errors(profileForm.email) }}
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Enregistrer les modifications
                            </button>

                        {{ form_end(profileForm) }}

                    </div>
                </div>

                <div class="mt-4">
                    <a href="{{ path('app_user_home') }}" class="btn btn-secondary">
                        Retour au tableau de bord
                    </a>
                </div>

            </div>
        </div>

    </div>
{% endblock %}