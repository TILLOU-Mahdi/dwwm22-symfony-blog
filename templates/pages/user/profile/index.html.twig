{% extends "themes/base_user.html.twig" %}

{% block title %}Mon profil{% endblock %}

{% block description %}Modification du profil utilisateur{% endblock %}

{% block body_class %}user-profile-body{% endblock %}

{% block main_class %}user-profile-main{% endblock %}

{% block main %}
    <section class="user-profile-page">
        <div class="container">

            <h1 class="text-center mb-4 display-5">
                Mon profil
            </h1>

            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10">

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success text-center">
                            {{ message }}
                        </div>
                    {% endfor %}

                    <div class="card user-profile-card mb-4">
                        <div class="card-body">

                            <h2 class="h4 mb-3">
                                Informations personnelles
                            </h2>

                            <p class="user-profile-date">
                                <strong>Date d’inscription :</strong>
                                {{ user.createdAt|date('d/m/Y H:i') }}
                            </p>

                            <hr>

                            {{ form_start(profileForm) }}

                                <div class="mb-3">
                                    {{ form_label(profileForm.firstName) }}
                                    {{ form_widget(profileForm.firstName, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">
                                        {{ form_errors(profileForm.firstName) }}
                                    </div>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(profileForm.lastName) }}
                                    {{ form_widget(profileForm.lastName, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">
                                        {{ form_errors(profileForm.lastName) }}
                                    </div>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(profileForm.email) }}
                                    {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">
                                        {{ form_errors(profileForm.email) }}
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    Enregistrer les informations
                                </button>

                            {{ form_end(profileForm) }}

                        </div>
                    </div>

                    <div class="card user-profile-card">
                        <div class="card-body">

                            <h2 class="h4 mb-3">
                                Modifier mon mot de passe
                            </h2>

                            <p class="text-muted">
                                Pour des raisons de sécurité, saisissez votre mot de passe actuel avant d’en choisir un nouveau.
                            </p>

                            <hr>

                            {{ form_start(passwordForm) }}

                                <div class="mb-3">
                                    {{ form_label(passwordForm.currentPassword) }}
                                    {{ form_widget(passwordForm.currentPassword, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">
                                        {{ form_errors(passwordForm.currentPassword) }}
                                    </div>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(passwordForm.plainPassword.first) }}
                                    {{ form_widget(passwordForm.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">
                                        {{ form_errors(passwordForm.plainPassword.first) }}
                                    </div>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(passwordForm.plainPassword.second) }}
                                    {{ form_widget(passwordForm.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                                    <div class="text-danger">
                                        {{ form_errors(passwordForm.plainPassword.second) }}
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    Modifier le mot de passe
                                </button>

                            {{ form_end(passwordForm) }}

                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a href="{{ path('app_user_home') }}" class="btn btn-secondary user-profile-back-btn">
                            Retour au tableau de bord
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </section>
{% endblock %}