{% extends "themes/base_visitor.html.twig" %}

{% block title %}Galerie des publications{% endblock %}

{% block description %}Découvrez les publications de Paul Martin autour de tableaux, d’artistes et de mouvements artistiques{% endblock %}

{% block keywords %}Tableaux, Art, Peinture, Publications, Paul Martin{% endblock %}

{% block main %}
    <h1 class="text-center my-3 display-5">Les œuvres commentées</h1>

    <div class="container my-5">

        <div class="mb-4">
            <h2 class="h5">Filtrer par thème</h2>

            <a href="{{ path('app_visitor_blog_index', {'tag': currentTag}) }}" class="btn btn-sm {% if not currentCategory %}btn-primary{% else %}btn-outline-primary{% endif %}">
                Tous
            </a>

            {% for category in categories %}
                <a href="{{ path('app_visitor_blog_index', {'category': category.slug, 'tag': currentTag}) }}" class="btn btn-sm {% if currentCategory == category.slug %}btn-primary{% else %}btn-outline-primary{% endif %}">
                    {{ category.name }}
                </a>
            {% endfor %}
        </div>

        <div class="mb-4">
            <h2 class="h5">Filtrer par artiste / tag</h2>

            <a href="{{ path('app_visitor_blog_index', {'category': currentCategory}) }}" class="btn btn-sm {% if not currentTag %}btn-secondary{% else %}btn-outline-secondary{% endif %}">
                Tous
            </a>

            {% for tag in tags %}
                <a href="{{ path('app_visitor_blog_index', {'category': currentCategory, 'tag': tag.slug}) }}" class="btn btn-sm {% if currentTag == tag.slug %}btn-secondary{% else %}btn-outline-secondary{% endif %}">
                    {{ tag.name }}
                </a>
            {% endfor %}
        </div>

        <div class="row">
            {% for post in posts %}
                <div class="col-md-4 mb-4">
                    <article class="card h-100">
                        {% if post.image %}
                            <img src="{{ asset('images/uploads/' ~ post.image) }}" class="card-img-top" alt="{{ post.title }}">
                        {% endif %}

                        <div class="card-body">
                            <h2 class="h5 card-title">{{ post.title }}</h2>

                            <p class="card-text">
                                {{ post.content|striptags|replace({
                                    '&eacute;':'é',
                                    '&egrave;':'è',
                                    '&ecirc;':'ê',
                                    '&agrave;':'à',
                                    '&ccedil;':'ç',
                                    '&Ccedil;':'Ç',
                                    '&rsquo;':'’',
                                    '&lsquo;':'‘',
                                    '&ldquo;':'“',
                                    '&rdquo;':'”',
                                    '&quot;':'"',
                                    '&amp;':'&',
                                    '**':''
                                })|slice(0,150) }}...
                            </p>

                            <a href="{{ path('app_visitor_blog_show', {'slug': post.slug}) }}" class="btn btn-primary">
                                Lire la suite
                            </a>
                        </div>
                    </article>
                </div>
            {% else %}
                <p class="text-center">Aucune œuvre commentée pour le moment.</p>
            {% endfor %}
        </div>

        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(posts) }}
        </div>

    </div>
{% endblock %}