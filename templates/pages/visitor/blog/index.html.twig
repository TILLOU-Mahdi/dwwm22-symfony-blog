{% extends "themes/base_visitor.html.twig" %}

{% block title %}Galerie des œuvres{% endblock %}

{% block description %}
    Découvrez les publications de Paul Martin autour de tableaux,
    d’artistes et de mouvements artistiques
{% endblock %}

{% block keywords %}
    Tableaux, Art, Peinture, Publications, Paul Martin
{% endblock %}

{% block main %}

<section class="blog-gallery-page">

    <div class="container py-5">

        <h1 class="text-center mb-5 display-5">
            Galerie des œuvres
        </h1>



        {# =========================
                FILTRES
        ========================== #}

<div class="blog-filter-actions mb-4">

    <button
        class="blog-filter-toggle"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#categoryFilters"
        aria-expanded="false"
        aria-controls="categoryFilters"
    >
        Filtrer par thème
    </button>

    <button
        class="blog-filter-toggle"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#tagFilters"
        aria-expanded="false"
        aria-controls="tagFilters"
    >
        Filtrer par artiste / tag
    </button>

</div>

<div class="collapse mb-4" id="categoryFilters">
    <div class="art-filter-box">

        <div class="art-filter-list">

            <a
                href="{{ path('app_visitor_blog_index', {'tag': currentTag}) }}"
                class="art-filter-btn {% if not currentCategory %}is-active{% endif %}"
            >
                Tous
            </a>

            {% for category in categories %}
                <a
                    href="{{ path('app_visitor_blog_index', {
                        'category': category.slug,
                        'tag': currentTag
                    }) }}"
                    class="art-filter-btn {% if currentCategory == category.slug %}is-active{% endif %}"
                >
                    {{ category.name }}
                </a>
            {% endfor %}

        </div>

    </div>
</div>

<div class="collapse mb-5" id="tagFilters">
    <div class="art-filter-box">

        <div class="art-filter-list">

            <a
                href="{{ path('app_visitor_blog_index', {
                    'category': currentCategory
                }) }}"
                class="art-filter-btn {% if not currentTag %}is-active{% endif %}"
            >
                Tous
            </a>

            {% for tag in tags %}
                <a
                    href="{{ path('app_visitor_blog_index', {
                        'category': currentCategory,
                        'tag': tag.slug
                    }) }}"
                    class="art-filter-btn {% if currentTag == tag.slug %}is-active{% endif %}"
                >
                    {{ tag.name }}
                </a>
            {% endfor %}

        </div>

    </div>
</div>

        {# =========================
           ARTICLES
        ========================== #}

        <div class="row">

            {% for post in posts %}

                <div class="col-md-4 mb-4">

                    <article class="card blog-card h-100">

                        {% if post.image %}

                            <a
                                href="{{ path('app_visitor_blog_show', {
                                    'slug': post.slug
                                }) }}"

                                class="blog-card-image-link"
                            >
                                <img
                                    src="{{ asset('images/uploads/' ~ post.image) }}"
                                    class="card-img-top"
                                    alt="{{ post.title }}"
                                >
                            </a>

                        {% endif %}

                        <div class="card-body d-flex flex-column">

                            <h2 class="h5 card-title">

                                <a
                                    href="{{ path('app_visitor_blog_show', {
                                        'slug': post.slug
                                    }) }}"

                                    class="blog-card-title-link"
                                >
                                    {{ post.title }}
                                </a>

                            </h2>

                            <p class="card-text blog-card-summary">

                                {{ post.description|striptags|slice(0, 180) }}...

                            </p>

                            <a
                                href="{{ path('app_visitor_blog_show', {
                                    'slug': post.slug
                                }) }}"

                                class="btn btn-primary mt-auto"
                            >
                                Lire la suite
                            </a>

                        </div>

                    </article>

                </div>

            {% else %}

                <p class="text-center">
                    Aucune œuvre commentée pour le moment.
                </p>

            {% endfor %}

        </div>

        {# =========================
           PAGINATION
        ========================== #}

        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(posts) }}
        </div>

    </div>

</section>

{% endblock %}