{% extends "themes/base_visitor.html.twig" %}

{% block title %}{{ post.title }}{% endblock %}

{% block description %}{{ post.description }}{% endblock %}

{% block keywords %}{{ post.keywords }}{% endblock %}


{% block main %}
  <div class="blog-show-full-bg">
    <article class="container py-5 blog-show-page">
        <h1 class="text-center mb-4">{{ post.title }}</h1>

        {% if post.image %}
            <div class="blog-show-image-wrapper">
                <img
                    src="{{ asset('images/uploads/' ~ post.image) }}"
                    class="img-fluid blog-show-image"
                    alt="{{ post.title }}"
                    data-bs-toggle="modal"
                    data-bs-target="#postImageModal"
                >
            </div>

            <div class="modal fade" id="postImageModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-xl">
                    <div class="modal-content blog-image-modal-content">
                        <button
                            type="button"
                            class="btn-close blog-image-modal-close"
                            data-bs-dismiss="modal"
                            aria-label="Fermer"
                        ></button>

                        <img
                            src="{{ asset('images/uploads/' ~ post.image) }}"
                            class="img-fluid blog-image-modal-img"
                            alt="{{ post.title }}"
                        >
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="blog-show-content mt-4">
            {{ post.content|raw }}
        </div>

        <div class="mt-4">
            {% if app.user %}
                <a href="{{ path('app_post_like', {'id': post.id}) }}" class="btn btn-outline-primary">
                    👍 J’aime
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                    Connectez-vous pour liker
                </a>
            {% endif %}

            <span class="ms-2">
                {{ post.likes|length }} like(s)
            </span>
        </div>
    </article>

    <hr class="my-5">

    <section class="container pb-5 blog-comments-section">
        <h2>Commentaires</h2>

        {% for comment in post.comments %}
            {% if comment.isApproved %}
                <div class="border rounded p-3 my-3">
                    <p class="mb-1">{{ comment.content }}</p>

                    <small class="text-muted">
                        Publié le {{ comment.createdAt|date('d/m/Y à H:i') }}
                        {% if comment.user %}
                            par {{ comment.user.email }}
                        {% endif %}
                    </small>

                    {% if app.user %}
                        <div class="mt-2">
                            {% if comment.user == app.user %}
                                <a href="{{ path('app_comment_edit', {'id': comment.id}) }}" class="btn btn-warning btn-sm">
                                    Modifier
                                </a>
                            {% endif %}

                            {% if comment.user == app.user or is_granted('ROLE_ADMIN') %}
                                <form method="post" action="{{ path('app_comment_delete', {'id': comment.id}) }}" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Supprimer
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        {% else %}
            <p>Aucun commentaire pour le moment.</p>
        {% endfor %}

        <hr class="my-4">

        {% if app.user %}
            {{ form_start(commentForm) }}
                {{ form_row(commentForm.content) }}

                <button type="submit" class="btn btn-primary">
                    Envoyer le commentaire
                </button>
            {{ form_end(commentForm) }}
        {% else %}
            <p>
                <a href="{{ path('app_login') }}">Connectez-vous</a>
                pour laisser un commentaire.
            </p>
        {% endif %}
    </section>
  </div>
{% endblock %}