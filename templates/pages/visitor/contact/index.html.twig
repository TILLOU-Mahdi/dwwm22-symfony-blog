{% extends "themes/base_visitor.html.twig" %}

{% block title %}Contactez-moi{% endblock %}

{% block description %}Contactez-moi pour plus d'informations{% endblock %}

{% block keywords %}Contact, Art, Peinture, Paul Martin{% endblock %}

{% block main %}
    <section class="auth-page auth-contact-bg">
        <div class="auth-container justify-content-center">
            <div class="auth-card auth-contact-card w-100">
                <h1>Contactez-moi</h1>

                <p class="mb-4">
                    Vous souhaitez discuter d’un tableau, proposer une œuvre ou simplement partager votre ressenti ?
                    Contactez Paul Martin.
                </p>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success text-center text-success" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(contactForm, {'attr': {'class': 'w-100'}}) }}

                    <div class="mb-3">
                        {{ form_label(contactForm.name) }}
                        {{ form_widget(contactForm.name, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger">
                            {{ form_errors(contactForm.name) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(contactForm.email) }}
                        {{ form_widget(contactForm.email, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger">
                            {{ form_errors(contactForm.email) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(contactForm.subject) }}
                        {{ form_widget(contactForm.subject, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger">
                            {{ form_errors(contactForm.subject) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(contactForm.message) }}
                        {{ form_widget(contactForm.message, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                        <div class="text-danger">
                            {{ form_errors(contactForm.message) }}
                        </div>
                    </div>

                    <button formnovalidate type="submit" class="btn btn-primary shadow w-100">
                        Envoyer
                    </button>

                {{ form_end(contactForm) }}

                <div class="text-center mt-4">
                    <a href="{{ path('app_visitor_welcome') }}">Retour à l'accueil</a>
                </div>
            </div>
        </div>
    </section>
{% endblock %}