<!DOCTYPE html>
<html lang="fr" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block description %}{% endblock %}">
    <meta name="author" content="Paul Martin">
    <meta name="publisher" content="DWWM22">

    <title>{% block title %}{% endblock %} · Administration - Regards d’Art</title>

    {% block keywords %}{% endblock %}

    <link rel="canonical" href="https://regards-d-art.com">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {% block j_query %}{% endblock %}
    {% block data_tables %}{% endblock %}
    {% block tiny_mce %}{% endblock %}
    {% block select2 %}{% endblock %}

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#4a3323">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    >
</head>

<body class="body-admin">

<header class="admin-topbar navbar sticky-top flex-md-nowrap p-0 shadow">
    <a class="admin-brand col-md-3 col-lg-2 me-0 px-3" href="{{ path('app_admin_home') }}">
        Regards d'Art
    </a>

    <div class="admin-topbar-title d-none d-md-block">
        Administration
    </div>

    <ul class="navbar-nav flex-row d-md-none ms-auto">
        <li class="nav-item text-nowrap">
            <button
                class="nav-link px-3 text-white"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#sidebarMenu"
                aria-controls="sidebarMenu"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <i class="fa-solid fa-bars"></i>
            </button>
        </li>
    </ul>
</header>

<div class="container-fluid">
    <div class="row">
        <aside class="admin-sidebar sidebar col-md-3 col-lg-2 p-0">
            <div
                class="offcanvas-md offcanvas-end admin-sidebar-panel"
                tabindex="-1"
                id="sidebarMenu"
                aria-labelledby="sidebarMenuLabel"
            >
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="sidebarMenuLabel">Regards d'Art</h5>
                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="offcanvas"
                        data-bs-target="#sidebarMenu"
                        aria-label="Close"
                    ></button>
                </div>

                <div class="offcanvas-body d-md-flex flex-column p-0 pt-lg-3 overflow-y-auto">
                    <ul class="admin-nav nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_home') }}">
                                <i class="fa-solid fa-house"></i>
                                Tableau de bord
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_category_index') }}">
                                <i class="fa-solid fa-folder"></i>
                                Courants artistiques
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_post_index') }}">
                                <i class="fa-solid fa-feather"></i>
                                Œuvres
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_tag_index') }}">
                                <i class="fa-solid fa-hashtag"></i>
                                Artistes / Thèmes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_contact_message_index') }}">
                                <i class="fa-solid fa-message"></i>
                                Messages reçus
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_user_index') }}">
                                <i class="fa-solid fa-users"></i>
                                Utilisateurs
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_admin_comment_index') }}">
                                <i class="fa-solid fa-comment"></i>
                                Commentaires
                            </a>
                        </li>
                    </ul>

                    <hr class="admin-separator">

                    <ul class="admin-nav nav flex-column mb-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_user_home') }}">
                                <i class="fa-solid fa-outdent"></i>
                                Espace utilisateur
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_visitor_welcome') }}">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                                Retour au site
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_logout') }}">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                Déconnexion
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>

        <main class="admin-main col-md-9 ms-sm-auto col-lg-10 px-md-4">
            {% block main %}{% endblock %}
        </main>
    </div>
</div>

</body>
</html>