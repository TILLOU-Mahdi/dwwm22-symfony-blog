<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {% block title %}{% endblock %} - Regards d’Art de Paul Martin
    </title>

    {# SEO #}
    <meta name="robots" content="index, follow">
    <meta name="description" content="{% block description %}{% endblock %}">
    <meta name="keywords" content="{% block keywords %}{% endblock %}">
    <meta name="author" content="Paul Martin">
    <meta name="publisher" content="Regards d'Art">
    <meta name="theme-color" content="#712cf9">

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet"
    >

    {# Webpack Encore #}
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    {# Favicon #}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
</head>

<body class="body-visitor">

    {# =========================
       NAVBAR
    ========================== #}

    <nav class="navbar navbar-expand-lg">

        <div class="container-fluid">

            <a class="navbar-brand" href="{{ path('app_visitor_welcome') }}">
                Regards d'Art
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                {# MENU GAUCHE #}

                <ul class="navbar-nav">

                    <li class="nav-item">
                        <a
                            class="nav-link {{ app.request.attributes.get('_route') == 'app_visitor_welcome' ? 'active' : '' }}"
                            href="{{ path('app_visitor_welcome') }}"
                        >
                            Accueil
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link {{ app.request.attributes.get('_route') starts with 'app_visitor_about' ? 'active' : '' }}"
                            href="{{ path('app_visitor_about_index') }}"
                        >
                            À propos de Paul
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link {{ app.request.attributes.get('_route') starts with 'app_visitor_blog' ? 'active' : '' }}"
                            href="{{ path('app_visitor_blog_index') }}"
                        >
                            Les œuvres
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link {{ app.request.attributes.get('_route') starts with 'app_visitor_contact' ? 'active' : '' }}"
                            href="{{ path('app_visitor_contact_index') }}"
                        >
                            Contact
                        </a>
                    </li>

                </ul>

                {# MENU DROITE #}

                <ul class="navbar-nav ms-auto">

                    {% if app.user %}

                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a
                                    href="{{ path('app_admin_home') }}"
                                    class="nav-link"
                                >
                                    Espace admin
                                </a>
                            </li>
                        {% endif %}

                        {% if is_granted('ROLE_USER') %}
                            <li class="nav-item">
                                <a
                                    href="{{ path('app_user_home') }}"
                                    class="nav-link"
                                >
                                    Espace privé
                                </a>
                            </li>
                        {% endif %}

                        <li class="nav-item">
                            <a
                                href="{{ path('app_logout') }}"
                                class="nav-link"
                            >
                                Déconnexion
                            </a>
                        </li>

                    {% else %}

                        <li class="nav-item">
                            <a
                                href="{{ path('app_login') }}"
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_login' ? 'active' : '' }}"
                            >
                                Connexion
                            </a>
                        </li>

                        <li class="nav-item">
                            <a
                                href="{{ path('app_register') }}"
                                class="nav-link {{ app.request.attributes.get('_route') == 'app_register' ? 'active' : '' }}"
                            >
                                Inscription
                            </a>
                        </li>

                    {% endif %}

                </ul>

            </div>

        </div>

    </nav>

    {# =========================
       MAIN
    ========================== #}

    <main>
        {% block main %}{% endblock %}
    </main>

    {# =========================
       FOOTER
    ========================== #}

    {% include "partials/_footer.html.twig" %}

</body>
</html>